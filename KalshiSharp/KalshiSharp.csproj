<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>KalshiSharp</RootNamespace>
    <AssemblyName>KalshiSharp</AssemblyName>
  </PropertyGroup>

  <!-- NuGet Package Configuration -->
  <PropertyGroup>
    <PackageId>KalshiSharp</PackageId>
    <VersionPrefix>1.3.0</VersionPrefix>
    <Title>KalshiSharp</Title>
    <Description>Production-grade .NET 8 SDK for the Kalshi prediction market API. Features REST and WebSocket clients with RSA-PSS signing, automatic retry, rate limiting, circuit breaker, OpenTelemetry observability, and full async/await support.</Description>
    <PackageTags>kalshi;kalshi-api;trading;api;sdk;dotnet-sdk;prediction-market;prediction-markets;websocket;websocket-client;rest;finance;betting;fintech</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Hurley451/KalshiSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Hurley451/KalshiSharp</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Adds API key administration, communications RFQs and quotes, order groups, subaccounts, portfolio transfers and settlements, multivariate collections, series discovery, incentives, live data, milestones and structured targets. Includes multi-ticker fills, localization, query filters, WebSocket metadata and KalshiCore conformance.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.2.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KalshiSharp.Tests" />
  </ItemGroup>

  <!-- Include README in package -->
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

</Project>
